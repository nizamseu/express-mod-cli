{
  "name": "express-mod-cli",
  "version": "1.5.0",
  "description": "Modern Express.js application generator: clean MVC modules with your own fields, Zod validation, pagination, SQL migrations, tests, JWT authentication, and Django-style AdminJS dashboard, in JavaScript or TypeScript, with MongoDB, PostgreSQL and MySQL (multiple databases). Install globally using 'npm install -g express-mod-cli'",
  "preferGlobal": true,
  "main": "bin/index.js",
  "bin": {
    "express-mod-cli": "bin/index.js"
  },
  "files": [
    "bin",
    "lib"
  ],
  "engines": {
    "node": ">=18.3.0"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "express",
    "generator",
    "mongodb",
    "mongoose",
    "postgresql",
    "mysql",
    "sequelize",
    "typescript",
    "multi-database",
    "mvc",
    "modular",
    "cli",
    "command-line",
    "boilerplate",
    "express-app",
    "api-generator",
    "rest-api",
    "nodejs",
    "zod",
    "validation",
    "migrations",
    "pagination",
    "authentication",
    "jwt",
    "admin",
    "adminjs",
    "dashboard"
  ],
  "author": "Nizam Uddin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nizamseu/express-mod-cli.git"
  },
  "dependencies": {
    "pluralize": "^8.0.0"
  }
}
